Vagrant.configure("2") do |config|
  config.vm.box = "ubuntu/jammy64"

  config.vm.define "node03" do |node|
    node.vm.hostname = "node03"
    node.vm.provider "virtualbox" do |vb|
      vb.name = "node03"
      vb.memory = 1536
      vb.cpus = 1
    end
    node.vm.network :public_network,
      ip: "192.168.1.30",
      bridge: %x{ip route | grep default | awk '{ print $5 }'}.chomp
  end
  config.vm.define "DB-node" do |node|
    node.vm.hostname = "DB-node"
    node.vm.provider "virtualbox" do |vb|
      vb.name = "DB-node"
      vb.memory = 1024
      vb.cpus = 1
    end
    node.vm.network :public_network,
      ip: "192.168.1.31",
      bridge: %x{ip route | grep default | awk '{ print $5 }'}.chomp
  end
end
